{
  "name": "ptp-ops",
  "version": "0.1.0",
  "private": true,
  "description": "ptp-bot — Slack front-end around a pi agent session for PTP ops investigations",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "ask": "tsx scripts/ask.ts",
    "check:slack": "tsx scripts/check-slack.ts",
    "backup": "tar czf - -C \"${BOT_STATE_DIR:-./state}\" . | aws s3 cp - \"s3://${BOT_BACKUP_BUCKET:-ptp-ops-backups}/state-$(date +%Y%m%d-%H%M).tgz\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@slack/socket-mode": "^2.0.0",
    "@slack/web-api": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}