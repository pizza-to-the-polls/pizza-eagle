{
  "name": "pizza-eagle",
  "version": "0.1.0",
  "private": true,
  "description": "pizza-eagle — Slack front-end around a pi agent session for PTP ops investigations",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "ask": "tsx scripts/ask.ts",
    "check:slack": "tsx scripts/check-slack.ts",
    "backup": "tar czf - --exclude='attachment-*' -C \"${BOT_STATE_DIR:-./state}\" . | aws s3 cp - \"s3://${BOT_BACKUP_BUCKET:-pizza-eagle-backups}/state-$(date +%Y%m%d-%H%M).tgz\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@bugsnag/js": "^9.1.0",
    "@slack/socket-mode": "^2.0.0",
    "@slack/web-api": "^7.9.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "js-yaml": "^5.5.0",
    "tsx": "^4.19.0"
  }
}
