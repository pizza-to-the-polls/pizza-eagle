# Slack app-level token (xapp-...) — Socket Mode. Required.
SLACK_APP_TOKEN=
# Slack bot token (xoxb-...). Required.
SLACK_BOT_TOKEN=
# Comma-separated channel IDs the bot answers in. Empty = any channel it's in.
ALLOWED_CHANNELS=
# Comma-separated user IDs allowed to trigger investigations. Empty = anyone.
ALLOWED_USERS=
# pi binary path (default: pi on PATH)
PI_BIN=pi
# Root for threads map, case workdirs, pi sessions (default: ./state)
BOT_STATE_DIR=./state
# Operator context dir (default: ../agent) — must contain AGENTS.md
AGENT_DIR=../agent
# Per-investigation wall clock (default: 600000 = 10 min)
INVESTIGATE_TIMEOUT_MS=600000
# Concurrent investigations (default: 2)
MAX_CONCURRENT=2
# Ops alert webhook for systemd OnFailure notifications
SLACK_ALERT_WEBHOOK=