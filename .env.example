# Slack app-level token (xapp-...) — Socket Mode. Required.
SLACK_APP_TOKEN=
# Slack bot token (xoxb-...). Required.
SLACK_BOT_TOKEN=
# Comma-separated channel IDs the bot answers in. Empty = any channel it's in.
ALLOWED_CHANNELS=
# Comma-separated user IDs allowed to trigger investigations. Empty = anyone.
ALLOWED_USERS=
# pi binary path (default: pi on PATH)
PI_BIN=pi
# Per-run model override (issue #34) — pi --model <provider/id> pattern.
# Unset = the staged settings.json default. The model must exist in the
# agent-dir catalog; for image attachments use a vision model, e.g.:
# PI_MODEL=or-pizza/z-ai/glm-5v-turbo
# Root for threads map, case workdirs, pi sessions (default: ./state)
BOT_STATE_DIR=./state
# Operator context dir (default: ./agent — repo-relative; must contain AGENTS.md)
AGENT_DIR=./agent
# Per-investigation wall clock (default: 600000 = 10 min)
INVESTIGATE_TIMEOUT_MS=600000
# Concurrent investigations (default: 2)
MAX_CONCURRENT=2
# Ops alert webhook for systemd OnFailure notifications
SLACK_ALERT_WEBHOOK=
# S3 bucket for nightly state backups (ops box only; see systemd/pizza-eagle-backup.timer)
BOT_BACKUP_BUCKET=
# ── Google Analytics (optional — investigations data source) ───────────
# Read-only service account JSON path (default ~/.config/ptp/ga-readonly.json;
# bootstrap writes it on the ops box from the ptp/prod/pizza-eagle/ga-readonly secret)
# GA_SA_JSON=
# Default GA4 property ID (numeric, from GA Admin → Property settings)
# GA_PROPERTY_ID=
# ── Production readiness ─────────────────────────────────────────────
# Bugsnag (listener errors report to the PTP project; same key the app uses)
# BUGSNAG_KEY=
# Nightly state-backup bucket (see systemd/pizza-eagle-backup.timer)
# BOT_BACKUP_BUCKET=pizza-eagle-backups
# Where unit failures post (bot uses its own token; webhook optional)
# SLACK_ALERT_CHANNEL=
# ── GitHub App pizza-eagle-agent (P4 — PRs + hotnready publish) ────
# App ID (PEM is fetched by scripts/gh-token.mjs from Secrets Manager)
# GH_APP_ID=
# ── AWS passthrough (reaches the pi subprocess env) ─────────────
# Read-only profile for investigations. MUST be set — otherwise aws
# commands fall back to the default/root identity (often expired SSO).
AWS_PROFILE=ptp-agent
