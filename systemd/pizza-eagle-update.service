[Unit]
Description=pizza-eagle update (pull latest agent + listener, rebuild, restart)
# OnFailure belongs in [Unit] — systemd silently ignores it in [Service]
# (the 2026-10-24..25 silent nightly failures never alerted for exactly
# this reason: the key sat in [Service] and every run died quietly).
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
# npm resolves node_modules/.bin from cwd — must run at the project root
WorkingDirectory=/opt/pizza-eagle
# The service runs as root (dnf needs it), but EVERY step that touches the
# repo runs as the pizza-eagle user that owns it. Root's git refuses a
# pizza-eagle-owned repo ("dubious ownership", exit 128) and root's npm
# leaves root-owned artifacts the next pizza-eagle run can't overwrite —
# between them they broke every nightly update from 2026-10-24 (box
# build) to 2026-10-25 while the bot silently stayed on day-1 code.
# runuser inherits this unit's cwd; git/npm need HOME (npm cache).
# --ff-only: never auto-merge; a diverged repo means the update fails
# loudly (OnFailure above posts to Slack) and a human looks at it.
#
# Dirty-tree guard (2026-10-28 incident): a dirty tracked path (e.g. #11's
# node_modules symlink that npm ci replaced with a real directory) made the
# next `git pull --ff-only` abort with "local changes would be overwritten"
# and left the bot running stale code until a human repaired the box.
# /opt/pizza-eagle is a deployment; GitHub is the source of truth, so any
# uncommitted change is bogus and safe to discard. Self-heal, then pull:
#   reset --hard + clean -fd (NEVER -x/-X: state/ and dist/ are git-ignored
#   runtime data — usage ledger, case history — and must survive).
# The guard runs as pizza-eagle via runuser like the pull: root's git
# refuses this repo ("dubious ownership", exit 128) — the silent-failure
# mode of 2026-10-24..25. Dirty paths are echoed to stdout → journald
# (journalctl -u pizza-eagle-update) for post-mortems.
# Single physical line: systemd does not join ExecStart* line continuations.
ExecStartPre=/usr/sbin/runuser -u pizza-eagle -- env HOME=/home/pizza-eagle /bin/bash -c 'dirty=$(git -C /opt/pizza-eagle status --porcelain); if [ -n "$dirty" ]; then echo "=== dirty-tree guard: unexpected uncommitted changes ==="; echo "$dirty"; echo "=== self-healing: git reset --hard HEAD + git clean -fd (ignored state/ + dist/ preserved) ==="; git -C /opt/pizza-eagle reset --hard HEAD; git -C /opt/pizza-eagle clean -fd; echo "=== dirty-tree guard: done, proceeding with pull ==="; fi'
# Belt-and-suspenders: if the tree is STILL dirty after self-heal (reset/
# clean failed on a lock or permissions error), fail the unit now so
# OnFailure alerts instead of the pull dying with a confusing git error.
ExecStartPre=/usr/sbin/runuser -u pizza-eagle -- env HOME=/home/pizza-eagle /bin/bash -c 'if [ -n "$(git -C /opt/pizza-eagle status --porcelain)" ]; then echo "dirty-tree guard: tree still dirty after self-heal" >&2; git -C /opt/pizza-eagle status --porcelain >&2; exit 1; fi'
ExecStart=/usr/sbin/runuser -u pizza-eagle -- env HOME=/home/pizza-eagle git -C /opt/pizza-eagle pull --ff-only
# Investigation-sandbox deps (2026-10-31 rebirth incident): pizza-eagle-investigation-
# net.service needs /usr/sbin/iptables, and install-units.sh's systemd-analyze
# verify hard-fails the whole nightly on a box born without it (the old box
# carried it out of band — a fresh t4g.medium failed every 04:30 run). Bootstrap
# §3b owns the rest (pizza-eagle-inv user, sudoers); this dnf is the piece that
# can rot between AMIs, so the nightly self-heals it.
ExecStart=/usr/bin/dnf install -y iptables-nft
# Security: pull Node.js patch releases from NodeSource nightly (no-op when
# current). Critical CVEs (e.g. the Oct 2026 RCE affecting 22.x) otherwise go
# unpatched until an instance is replaced. Service restart below picks up
# the new node binary.
ExecStart=/usr/bin/dnf update -y nodejs
ExecStart=/usr/sbin/runuser -u pizza-eagle -- env HOME=/home/pizza-eagle /usr/bin/npm ci --omit=dev
ExecStart=/usr/sbin/runuser -u pizza-eagle -- env HOME=/home/pizza-eagle /usr/bin/npm run build
# Unit-sync (2026-10-28 issue): the pull may have changed systemd/*.service or
# systemd/*.timer — install them BEFORE the restart so the restart picks up the
# fresh definition (bootstrap.sh §9 used to be the only installer; unit fixes
# sat dormant on the box until a human hand-copied them). systemd runs multiple
# ExecStartPost lines in order: sync + daemon-reload first, then the restart.
# If pizza-eagle-update.service (this unit) itself changed mid-run, the current
# run still uses the old definition; the next run picks the new one up — fine.
ExecStartPost=/opt/pizza-eagle/scripts/install-units.sh
# Skills-sync (2026-11-02 issue): same bootstrap-only gap as the unit-sync
# above — the pull may also have changed skills/<name>/SKILL.md, but
# bootstrap.sh §6 installs skills only at provisioning time, so skill fixes
# sat dormant on the box. install-skills.sh is add/update only (never
# deletes a box-side skill absent from the repo) and needs no daemon-reload:
# pi reads skills per session, so the restart below is all it takes.
ExecStartPost=/opt/pizza-eagle/scripts/install-skills.sh
ExecStartPost=/bin/systemctl restart pizza-eagle.service