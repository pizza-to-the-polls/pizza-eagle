[Unit]
Description=pizza-eagle unit failure notifier (%i)

[Service]
Type=oneshot
# SLACK_ALERT_WEBHOOK comes from the same Secrets Manager env file.
# Kept as a template unit so OnFailure=notify-failure@%n.service resolves.
ExecStart=/opt/pizza-eagle/scripts/notify-failure.sh %i
EnvironmentFile=/etc/pizza-eagle/.env