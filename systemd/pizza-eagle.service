[Unit]
Description=pizza-eagle — Slack front-end around a pi agent session
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated non-privileged user; its only AWS identity is the instance role
# (read-only triage policy). The bastion's DB-write surface stays unreadable.
User=pizza-eagle
Group=pizza-eagle
WorkingDirectory=/opt/pizza-eagle
# Written root-owned by bootstrap.sh from Secrets Manager (Slack tokens
# etc.). Root-owned 600: only systemd (PID1) reads this file — the bot
# user, and any pi investigation child it spawns, cannot.
EnvironmentFile=/etc/pizza-eagle/.env
ExecStart=/usr/bin/node dist/index.js
# Logs to file for the CloudWatch agent's files collector (journald input
# schema proved version-fragile); journald still records unit lifecycle.
StandardOutput=append:/var/log/pizza-eagle/bot.log
StandardError=append:/var/log/pizza-eagle/bot.log
Restart=always
RestartSec=10
# Hardening. NOTE (issue #5): NoNewPrivileges and RestrictSUIDSGID were
# REMOVED here — both block exec'ing setuid sudo, which the investigation
# wrapper (scripts/run-investigation-container.sh) needs to drop each pi
# run to pizza-eagle-inv (issue #5's durable isolation boundary). The
# listener loses those two knobs but gains a much stronger property: its
# children run as a DIFFERENT user in a container, and sudoers confines
# pizza-eagle to the single target pizza-eagle-inv (no root, no other
# users — /etc/sudoers.d/pizza-eagle-investigation, written by bootstrap).
# A compromised listener therefore still cannot escalate to root via sudo.
PrivateTmp=true
ProtectSystem=strict
# 2026-10-27 red team hardening: the bot + its pi children never need
# clocks, hostnames, kernel knobs, modules, or device nodes. Added alongside
# the pre-existing ProtectSystem/ProtectHome — not a substitute for the
# per-run sandbox follow-up (RUNBOOK) but closes ambient OS surfaces.
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
LockPersonality=yes
PrivateDevices=yes
# Rootless podman (investigation containers) needs /dev/fuse for its
# overlay storage — PrivateDevices=yes alone would hide it and every mode-1
# investigation would fall back to mode 2. DeviceAllow composes with
# PrivateDevices (DevicePolicy=closed + allowlist).
DeviceAllow=char-fuse
SystemCallArchitectures=native
# pi writes locks/state under ~/.pi/agent — the bot user's home must be
# writable despite ProtectHome=read-only (ReadWritePaths overrides it).
# /var/lib/pizza-eagle-inv: rootless podman's image store for the
# investigation user — the wrapper (child of this service) runs podman as
# pizza-eagle-inv, and ProtectSystem=strict would otherwise make that
# path read-only. The "-" prefix is load-bearing: the dir only materializes
# once the inv-user bootstrap lands (issue #30), and a ReadWritePaths entry
# that doesn't exist makes systemd fail the whole service at NAMESPACE
# setup (status=226) — the bot could not start AT ALL (2026-10-29 outage,
# ~05:04–05:05Z). install-units.sh also mkdir -p's it on every update.
ReadWritePaths=/opt/pizza-eagle/state /home/pizza-eagle /var/log/pizza-eagle -/var/lib/pizza-eagle-inv
ProtectHome=read-only
[Install]
WantedBy=multi-user.target