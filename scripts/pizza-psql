#!/usr/bin/env bash
# pizza-psql — human console access to the pizzabase cluster.
#
# Retires the old-bastion pattern of a psql connection string in bash
# history. The credential is fetched from Secrets Manager with YOUR
# identity (the bot's instance role has no grant on it) and passed via
# PGPASSWORD — never in argv, history, or any file on any server.
#
# Tunnel: ssh -L through the `ptp-ops` host config (SSM SSH session, no
# inbound on the box) on local port 15432 — deliberately NOT 5432, which
# a local dev Postgres would shadow.
#
# Usage: pizza-psql [-s SECRET] [-r ROLE] [psql args…]
#   pizza-psql                          # console as the app's DB user
#   pizza-psql -c 'select 1'            # one-shot queries
#   pizza-psql -r ptp_ro                # read-only role (same password secret)
#   pizza-psql -d pizzabasestage       # the stage database (same cluster/secret)
set -euo pipefail

# ── pi-guard ─────────────────────────────────────────────────────────────
# pizza-psql is a HUMAN tool (master credentials). Refuse to run if any
# ancestor process is a pi agent: walk the PPID chain and look for the
# pi-coding-agent process. Ancestry cannot be spoofed by descendants, so
# this blocks bot investigations AND interactive pi agents alike.
pid=$$
while [ "$pid" -gt 1 ] 2>/dev/null; do
  cmd=$(ps -o command= -p "$pid" 2>/dev/null || true)
  # match: the `pi` wrapper (first word == pi or .../pi), or the full
  # node pi-coding-agent path (the box). A space must follow "pi" so
  # pip/ping/... never match.
  case "$cmd" in
    "pi "*|"pi"|*/pi\ *|*pi-coding-agent*)
      echo "FATAL: pizza-psql is human-only — a pi process cannot invoke it" >&2; exit 1 ;;
  esac
  pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ') || break
  [ -z "$pid" ] && break
done

DB_OVERRIDE=""
SECRET="PizzaBase"   # the app's own secret — one copy of the credential
ROLE=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -r|--role)   ROLE="$2"; shift 2 ;;
    -d|--db)     DB_OVERRIDE="$2"; shift 2 ;;
    -s|--secret) SECRET="$2"; shift 2 ;;
    *)           args+=("$1"); shift ;;
  esac
done

HOST="pizzabase.cluster-c0xyw6eawjva.us-west-2.rds.amazonaws.com"
# Pick the first free port in this range: concurrent pizza-psql sessions
# (prod + stage side by side) each get their own; a stale tunnel from a
# crashed run is bypassed and dies on its own SSM idle timeout.
LOCAL_PORT=""
for p in $(seq 15432 15481); do
  if ! nc -z 127.0.0.1 "$p" 2>/dev/null; then LOCAL_PORT=$p; break; fi
done
[ -n "$LOCAL_PORT" ] || { echo "FATAL: no free local port in 15432-15481" >&2; exit 1; }

CREDS=$(AWS_REGION=us-west-2 aws secretsmanager get-secret-value \
  --secret-id "$SECRET" --query SecretString --output text)
USER=$(jq -r '.username // .user' <<<"$CREDS")
DB=$(jq -r '.dbname // "pizzabase"' <<<"$CREDS")   # dbClusterIdentifier is NOT a database name (it said database-1)
PASS=$(jq -r '.password' <<<"$CREDS")
unset CREDS
[ -n "$ROLE" ] && USER="$ROLE"
[ -n "$DB_OVERRIDE" ] && DB="$DB_OVERRIDE"
if [ -z "$USER" ] || [ "$USER" = "null" ]; then
  echo "FATAL: could not read username from secret $SECRET" >&2; exit 1
fi

ssh -o LogLevel=Error -N -L "${LOCAL_PORT}:${HOST}:5432" ptp-ops &
TUNNEL=$!
trap 'kill $TUNNEL 2>/dev/null' EXIT
echo "tunnel up (pid $TUNNEL) on 127.0.0.1:${LOCAL_PORT}…" >&2

ok=""
for i in $(seq 1 15); do
  if nc -z 127.0.0.1 "$LOCAL_PORT" 2>/dev/null; then ok=1; break; fi
  sleep 1
done
[ -n "$ok" ] || { echo "FATAL: tunnel never opened 127.0.0.1:${LOCAL_PORT}" >&2; exit 1; }

PGPASSWORD="$PASS" exec psql -h 127.0.0.1 -p "$LOCAL_PORT" -U "$USER" -d "$DB" "${args[@]}"
